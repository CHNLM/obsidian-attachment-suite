{
  "name": "attachment-suite",
  "version": "1.0.0",
  "description": "Obsidian attachment suite: localize, name, audit/collect, cleanup and export attachments in one plugin.",
  "main": "dist/attachment-suite/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:actions": "node scripts/check-action-pins.mjs",
    "version": "node version-bump.mjs"
  },
  "keywords": [
    "obsidian",
    "attachment",
    "localize",
    "cleaner"
  ],
  "license": "MIT",
  "engines": {
    "node": "24.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.13.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
